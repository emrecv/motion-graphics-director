{
  "name": "motion-graphics-studio",
  "version": "1.0.0",
  "private": true,
  "description": "An editable Remotion studio with brand films, a CDN explainer and documented audio",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "check": "tsc --noEmit && node scripts/check.mjs",
    "preview": "node scripts/render.mjs preview",
    "render": "node scripts/render.mjs final",
    "frames": "node scripts/frames.mjs",
    "verify": "python3 scripts/verify_export.py"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
